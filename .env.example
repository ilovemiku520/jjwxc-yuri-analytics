# Phase 0 is intentionally offline. The application rejects true values.
PYURI_ENABLE_NETWORK=false
# JJWXC public probe has a separate, default-off one-process network latch.
JJYURI_ENABLE_NETWORK=false
# Daily cloud collector defaults: one fixed yuri ranking, top 10 details, 2s gap.
JJYURI_RANKING_KEY=yuri_current
JJYURI_HYDRATE_TOP=10
JJYURI_REQUEST_INTERVAL_SECONDS=2
PYURI_LOG_LEVEL=INFO
PYURI_FIXTURE_MANIFEST=fixtures/manifest.json
PYURI_REPORT_DIR=var/reports
PYURI_API_HOST=127.0.0.1
PYURI_API_PORT=8000
PYURI_SHARED_CONSUMER_CONTROLS_ENABLED=true
PYURI_API_RATE_LIMIT_MAX_REQUESTS=120
PYURI_API_RATE_LIMIT_WINDOW_SECONDS=60
PYURI_API_RATE_LIMIT_MAX_CONSUMERS=100000
PYURI_API_AUDIT_RETENTION_DAYS=30
PYURI_CONSUMER_AUTH_MODE=disabled
# Runtime secret; do not commit a real value. Required only for trusted_hmac_proxy mode.
PYURI_TRUSTED_PROXY_ID=private-edge
PYURI_TRUSTED_PROXY_MAX_AGE_SECONDS=30
# PYURI_TRUSTED_PROXY_HMAC_SECRET=
# TLS files must be absolute inside the API runtime and configured as a pair.
# PYURI_API_TLS_CERT_FILE=/run/secrets/tls-certificate.pem
# PYURI_API_TLS_KEY_FILE=/run/secrets/tls-private-key.pem
PYURI_WEB_PORT=3000
PYURI_DATABASE_URL=postgresql+psycopg://pyuri:change-me-local-only@localhost:5432/pyuri
PYURI_POSTGRES_USER=pyuri
PYURI_POSTGRES_PASSWORD=change-me-local-only
PYURI_POSTGRES_DB=pyuri
# Optional project-local Docker Hub proxy overrides for restricted networks:
# PYURI_POSTGRES_IMAGE=m.daocloud.io/docker.io/library/postgres:17
# PYURI_PYTHON_BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.12-slim
# PYURI_NODE_BASE_IMAGE=m.daocloud.io/docker.io/library/node:22-alpine
