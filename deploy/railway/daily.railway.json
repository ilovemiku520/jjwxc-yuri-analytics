{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile",
    "watchPatterns": ["src/**", "migrations/**", "pyproject.toml", "apps/api/Dockerfile"]
  },
  "deploy": {
    "startCommand": "jjyuri-jjwxc-daily --ranking yuri_current --hydrate-top 10 --request-interval-seconds 2",
    "cronSchedule": "30 19 * * *",
    "restartPolicyType": "NEVER"
  }
}
