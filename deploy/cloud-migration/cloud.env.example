# Copy values into the cloud provider's encrypted variable store. Do not commit a filled copy.
PYURI_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@PRIVATE_HOST:5432/DATABASE?sslmode=require
PYURI_CLOUD_DATABASE_URL=postgresql://USER:PASSWORD@PUBLIC_MIGRATION_HOST:5432/DATABASE?sslmode=require
PYURI_COHORT_IMPORT_TOKEN=GENERATE_AT_LEAST_32_RANDOM_BYTES
PYURI_API_HOST=0.0.0.0
PYURI_API_DEPLOYMENT_SCOPE=private_container
PYURI_SHARED_CONSUMER_CONTROLS_ENABLED=true
PYURI_INTERNAL_API_URL=http://API_PRIVATE_HOST:PORT
JJYURI_ENABLE_NETWORK=false
