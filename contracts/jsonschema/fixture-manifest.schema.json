{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/fixture-manifest.schema.json",
  "title": "Offline fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "provider", "records"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_type", "source_id", "observed_at", "path"],
        "properties": {
          "entity_type": {
            "enum": ["work", "author", "tag_page", "search_page"]
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "path": {
            "type": "string",
            "pattern": "^[^\\\\/](?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).*\\.json$"
          },
          "status_code": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "content_type": {
            "type": "string"
          },
          "source_url": {
            "type": ["string", "null"]
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    }
  }
}

